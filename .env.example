# NZ TransitPulse - local configuration template.
# Copy to .env and fill in values. Never commit .env.

# --- Application ---
TP_ENVIRONMENT=local
TP_API_V1_PREFIX=/api/v1
TP_CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL 8) ---
# TP_DATABASE_URL is the only database setting the application reads.
# Point it at your LOCAL MySQL server; no Docker is required.
TP_DATABASE_URL=mysql+pymysql://transitpulse:transitpulse@127.0.0.1:3306/transitpulse
TP_DATABASE_ECHO=false
# The MYSQL_* variables below are used ONLY by the optional docker-compose.yml.
MYSQL_DATABASE=transitpulse
MYSQL_USER=transitpulse
MYSQL_PASSWORD=transitpulse
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PORT=3306

# --- GTFS static feed ---
# Official Auckland Transport GTFS bundle. Override if AT changes the URL.
TP_GTFS_STATIC_URL=https://gtfs.at.govt.nz/gtfs.zip
TP_GTFS_DATA_DIR=data/gtfs

# --- Auckland Transport developer portal ---
# Register at https://dev-portal.at.govt.nz and use the subscription key.
# Leave TP_AT_API_KEY empty until Phase 2; the API then reports realtime as not configured.
TP_AT_API_BASE_URL=https://api.at.govt.nz
TP_AT_API_KEY=
# Confirm the exact endpoint paths attached to your subscription in the developer
# portal (legacy GTFS-RT and Realtime Compat APIs use different paths).
TP_AT_VEHICLE_POSITIONS_URL=
TP_AT_TRIP_UPDATES_URL=
TP_AT_SERVICE_ALERTS_URL=
# AT refreshes GTFS-Realtime at least every 30 seconds. Values below 30 are rejected.
TP_AT_REALTIME_POLL_SECONDS=30
